APP_NAME="Meta Intel Field Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi
WEB_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=field_ops
DB_USERNAME=field_ops
DB_PASSWORD=change-me-locally

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_TOKEN_TTL_MINUTES=1440
EVIDENCE_DISK=evidence
UPLOAD_MAX_KB=10240

# First administrator, used only by `php artisan db:seed`. Never commit real values.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
